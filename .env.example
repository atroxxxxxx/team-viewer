LETSENCRYPT_EMAIL=admin@example.com
TICKET_DOMAIN=tickets.example.com
RELAY_DOMAIN=relay.example.com
# 1 — учебный центр Let's Encrypt, браузер такому сертификату не доверяет
LETSENCRYPT_STAGING=0

# Задайте собственные случайные пароли и токен перед запуском Compose.
CLIENT_PASSWORD=
OPERATOR_PASSWORD=
# Или укажите объект JSON, где ключи — отдельные логины, значения — их пароли.
# OPERATOR_ACCOUNTS_JSON=
RELAY_INGEST_TOKEN=
# Для отдельного relay: каталог с fullchain.pem и privkey.pem.
# RELAY_TLS_DIR=/absolute/path/to/relay-tls
# RELAY_INGEST_BIND=127.0.0.1
