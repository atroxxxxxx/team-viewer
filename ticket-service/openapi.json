{
  "openapi": "3.0.3",
  "info": {
    "title": "Сервис заявок",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Проверка процесса и PostgreSQL",
        "responses": {"200": {"description": "ok"}}
      }
    },
    "/api/v1/tickets": {
      "post": {
        "summary": "Создать заявку с описанием проблемы",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["account_id", "description"],
                "properties": {
                  "account_id": {"type": "string", "format": "uuid"},
                  "description": {"type": "string"},
                  "camera": {"type": "boolean"}
                }
              }
            }
          }
        },
        "responses": {"201": {"description": "заявка создана"}}
      },
      "get": {
        "summary": "Очередь заявок со статусом queued, без uuid клиента и секретов сессии",
        "responses": {"200": {"description": "список"}}
      }
    },
    "/api/v1/tickets/{id}": {
      "get": {
        "summary": "Прочитать заявку",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "заявка"}, "404": {"description": "нет заявки"}}
      }
    },
    "/api/v1/tickets/{id}/claim": {
      "post": {
        "summary": "Утвердить заявку, открыть туннель и вернуть секрет оператора",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "туннель создан"}, "409": {"description": "уже занята"}, "502": {"description": "ретранслятор недоступен"}}
      }
    },
    "/api/v1/tickets/{id}/session": {
      "get": {"summary": "Чат, план, грант и секрет своей роли. Чужому оператору только статус", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "снимок сессии"}}}
    },
    "/api/v1/tickets/{id}/messages": {
      "post": {"summary": "Сообщение чата", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "отправлено"}}}
    },
    "/api/v1/tickets/{id}/control-requests": {
      "post": {"summary": "Запросить управление", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "грант pending"}}}
    },
    "/api/v1/tickets/{id}/control-requests/{grant}/decision": {
      "post": {"summary": "Ответ клиента на управление", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "grant", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "решение записано"}}}
    },
    "/api/v1/tickets/{id}/input": {
      "post": {"summary": "Событие ввода после валидатора оператора", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "proposed"}}}
    },
    "/api/v1/tickets/{id}/input/{action}/result": {
      "post": {"summary": "Результат валидатора клиента", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "action", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "фаза обновлена"}}}
    },
    "/api/v1/tickets/{id}/actions": {
      "post": {"summary": "Записать отказ правил, не исполняя действие", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "blocked_by_policy"}}}
    },
    "/api/v1/tickets/{id}/plans": {
      "post": {"summary": "План шагов", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "план создан"}}}
    },
    "/api/v1/tickets/{id}/steps/{step}/observations": {
      "post": {"summary": "Наблюдение клиента по шагу", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "step", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "записано"}}}
    },
    "/api/v1/tickets/{id}/steps/{step}/complete": {
      "post": {"summary": "Отметить шаг после наблюдения", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "step", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "done"}}}
    },
    "/api/v1/tickets/{id}/problems": {
      "post": {"summary": "Дочерняя проблема и вложенный план", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "проблема создана"}}}
    },
    "/api/v1/tickets/{id}/release": {
      "post": {"summary": "Назначенный оператор возвращает открытую заявку в очередь", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "queued"}, "403": {"description": "заявка другого оператора"}, "409": {"description": "заявка уже завершена"}}}
    },
    "/api/v1/tickets/{id}/resolution": {
      "post": {"summary": "Решено клиента закрывает сразу. Не решено закрывает с комментарием. Предложение оператора ждёт клиента", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "статус сессии"}, "409": {"description": "у оператора остались открытые шаги"}}}
    }
  }
}
