@startdot
digraph triangle {
  graph [
    rankdir=TB
    splines=true
    pad=0.5
    fontname="DejaVu Sans"
    label="09. Сервис заявок, оператор, ретранслятор и клиент"
    labelloc=t
    fontsize=16
  ]
  node [fontname="DejaVu Sans", fontsize=14, shape=box, style="filled,rounded", fillcolor="#FFFDE7"]
  edge [fontname="DejaVu Sans", fontsize=12]

  Tickets [label="сервис заявок"]
  Operator [label="оператор"]
  Relay [label="ретранслятор"]
  Client [label="клиент"]

  { rank=same; Operator; Relay; Client }

  Operator -> Tickets [label="запрашивает заявку"]
  Client -> Tickets [label="кладёт заявку\nс описанием проблемы"]
  Tickets -> Relay [label="получает заявку\nпосле утверждения оператором"]
  Operator -> Relay [style=dashed, dir=none]
  Relay -> Client [style=dashed, dir=none]
}
@enddot
