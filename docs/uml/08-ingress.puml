@startuml 08-ingress
title 08. Вход: сертификаты, nginx, учётные записи
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign left
autonumber

participant "Контейнер certs" as Certs
participant "Let's Encrypt" as LE
participant "Nginx" as Edge
participant "Сервис заявок" as Tickets
participant "Ретранслятор" as Relay
actor "Браузер" as Browser

alt В .env заданы два DNS-имени
  Certs -> LE : HTTP-01 на порту 80\nTICKET_DOMAIN и RELAY_DOMAIN
  LE -> Certs : Сертификаты
  Certs -> Edge : tls.conf для обоих имён
else .env пуст или DNS не подтверждён
  Certs -> Edge : локальный сертификат\nтолько 127.0.0.1:443
end
note over Certs, Edge
  Контейнер certs завершается
  до старта заявок, ретранслятора и nginx.
  Пустой .env не останавливает стек.
end note

alt Сертификат есть
  Browser -> Edge : http://127.0.0.1:8080/
  Edge -> Browser : 301 https://127.0.0.1/
  Browser -> Edge : https://127.0.0.1/
  Edge -> Browser : 302 /swagger/tickets/
  opt Let's Encrypt подтвердил имена
    Browser -> Edge : http://TICKET_DOMAIN/
    Edge -> Browser : 301 https://TICKET_DOMAIN/
  end
else Сертификата нет
  Browser -> Edge : http://127.0.0.1:8080/
  Edge -> Browser : 302 /swagger/tickets/
end

Browser -> Edge : http://другой-адрес:8080/
Edge -> Browser : Соединение закрыто без ответа

Browser -> Edge : https://TICKET_DOMAIN/api/
Edge -> Tickets : 127.0.0.1:18080
Tickets -> Edge : Ответ API
Edge -> Browser : HTTPS

Browser -> Edge : https://RELAY_DOMAIN/api/
Edge -> Relay : 127.0.0.1:18081\nтолько Basic operator для /api/v1/paths
Relay -> Edge : Ответ API

Browser -> Edge : https://имя/
Edge -> Browser : Соединение закрыто без ответа
@enduml
