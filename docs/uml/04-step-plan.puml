@startuml 04-step-plan
title 04. План шагов и вложенные проблемы
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign left
autonumber

actor "Оператор" as Operator
participant "Приложение оператора" as OpApp
participant "Правила" as Policy
participant "Сервис заявок" as Tickets
database "PostgreSQL" as DB
participant "Клиентское приложение" as Client

Operator -> OpApp : Составить план
OpApp -> Policy : Каждый шаг сверить с запретами
Policy -> OpApp : Шаги, которые можно публиковать
OpApp -> Tickets : POST /plans {steps[]}\nBasic operator, заявка его
Tickets -> DB : INSERT plan и plan_steps todo
Tickets -> DB : status=guided,\nесли нет remote_control
Client -> Tickets : GET /session
Tickets -> Client : Шаги
Client -> Client : Показать TODO

loop Пока есть незакрытые шаги
  Client -> Tickets : POST /steps/{id}/observations\nX-Ticket-Token
  Tickets -> DB : INSERT observation
  alt Шаг выполнен
    Operator -> OpApp : Вижу на экране или есть наблюдение
    OpApp -> Tickets : POST /steps/{id}/complete
    Tickets -> DB : step=done
  else Шаг породил новую проблему
    Operator -> OpApp : Описание и новый план
    OpApp -> Policy : Сверить новый план
    OpApp -> Tickets : POST /problems
    Tickets -> DB : problem, родительский step=blocked,\nдочерний plan
    note over Operator, Client
      Вложенный план идёт тем же циклом.
      Родительский шаг должен принадлежать этой заявке.
    end note
  else Шаг не прошёл
    OpApp -> Tickets : POST /steps/{id}/revise
    Tickets -> DB : старый step=cancelled,\nновый step=todo
  end
  Client -> Tickets : GET /session
  Tickets -> Client : Обновлённый TODO
end
@enduml
