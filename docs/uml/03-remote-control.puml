@startuml 03-remote-control
title 03. Разрешение и удалённое управление
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign left
autonumber

actor "Оператор" as Operator
participant "Приложение оператора" as OpApp
participant "Правила" as Policy
participant "Сервис заявок" as Tickets
database "PostgreSQL" as DB
participant "Клиентское приложение" as Client
participant "Валидатор клиента" as Guard

Operator -> OpApp : Решает править сам
OpApp -> Policy : Сверить намерение
Policy -> OpApp : Намерение допустимо
OpApp -> Tickets : POST /control-requests\nBasic operator, заявка его
Tickets -> DB : grant=pending,\nstatus=awaiting_permission

loop Опрос сессии
  Client -> Tickets : GET /session\nBasic client, X-Ticket-Token
  Tickets -> Client : control.status=pending
end
Client -> Client : Диалог разрешения

alt Клиент отказал
  Client -> Tickets : POST decision {allow: false}
  Tickets -> DB : grant=denied, status=guided
  note over OpApp, Client
    Дальше диаграмма 04.
  end note
else Клиент разрешил
  Client -> Tickets : POST decision\n{allow: true, scope}
  note over Tickets
    scope только pointer, key, text.
    Другие слова отклоняются.
  end note
  Tickets -> DB : grant=active, expires_at,\nstatus=remote_control

  loop Пока грант активен
    Operator -> OpApp : Мышь, клавиша или текст
    OpApp -> Policy : Проверка до сети
    alt Правило запрещает
      Policy -> OpApp : Не отправлять
      OpApp -> Tickets : POST /actions\nphase=blocked_by_policy
    else Правило пропускает
      OpApp -> Tickets : POST /input
      Tickets -> DB : action_log phase=proposed
      Client -> Tickets : GET /session
      Tickets -> Client : Ожидающее событие
      Client -> Guard : Схема, намерение, кадр
      alt Клиент отклонил
        Client -> Tickets : result=rejected_by_client
      else Клиент пропустил
        Guard -> Client : xdotool, если он есть
        Client -> Tickets : result=applied
        Tickets -> DB : phase=applied
      end
    end
  end
end
@enduml
